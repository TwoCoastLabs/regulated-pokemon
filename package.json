{
  "name": "regulated-pokemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "What if a Pokémon assistant were regulated like a bank? An enforcement-kernel demo of provably factual, compliant AI agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && tsc --noEmit -p app",
    "build": "tsc -p tsconfig.build.json",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:preview": "vite preview --config app/vite.config.ts",
    "demo": "npm run build && node dist/demo/cli.js",
    "harness": "npm run build && node dist/harness/cli.js",
    "harness:live": "npm run build && node dist/harness/live-cli.js",
    "session:trace": "npm run build && node dist/session/trace-cli.js",
    "coverage:map": "npm run build && node dist/harness/coverage-cli.js",
    "harness:results": "npm run build && node dist/harness/results-cli.js",
    "precedents:promote": "npm run build && node dist/memory/promote-cli.js",
    "relay": "npm run app:build && npm run build && node dist/relay/serve.js",
    "snapshot:fetch": "node --experimental-strip-types scripts/fetch-snapshot.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "preact": "^10.29.8",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  }
}
